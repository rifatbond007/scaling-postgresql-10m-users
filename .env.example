# Copy to .env (or run `make env` to generate one with random passwords).
# .env is git-ignored: never commit real passwords.

# password of the postgres superuser (used by the bench client and PgBouncer users)
POSTGRES_PASSWORD=change-me
# password of the replication user the replicas connect with (Step 4)
REPLICATOR_PASSWORD=change-me-too

# max_connections of the primary (Step 3 experiments raise it, e.g. 2500)
PG_MAX_CONN=100
